<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	  <modelVersion>4.0.0</modelVersion>
	  
      <groupId>com.penalara.ghc</groupId>
	  <artifactId>jsonGhcFiles</artifactId>
	  <version>3.5.1-SNAPSHOT</version>
      <packaging>pom</packaging>
	  

	<!-- Version ejecucion JAVA -->
	<name>Json Ghc Files</name>
	<description>Proyecto para generar las clases POJO Java del formato JSON de GHC a traves del jsonSchema.</description>
	<url>https://github.com/penalara/</url>
    <organization>
        <name>Peñalara Software S.L.</name>
        <url>https://www.penalara.com</url>
     </organization>
	
	<!-- License for the project -->
    <licenses>
        <license>
            <name>GNU Lesser General Public License v2.1</name>
            <url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html</url>
        </license>
    </licenses>
    
	<!-- Developers on project -->
	<developers>
	   	<developer>
	      <name>David B.</name>
	      <email>dburgos@penalara.com</email>
	      <organization>${project.organization.name}</organization>
	      <organizationUrl>${project.organization.url}</organizationUrl>
	    </developer>
  	</developers>
	
	
	<!-- Version ejecucion JAVA -->
	<properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <autoVersionSubmodules>true</autoVersionSubmodules>
        <typescript.propertiesFile>${maven.multiModuleProjectDirectory}/src/main/resources/typescript-interfaces.properties</typescript.propertiesFile>
	</properties>
	
    <!-- Project modules-->
    <modules>        
        <module>modules/plannerGHCFile</module>
        <module>modules/engineGHCFile</module>
        <module>modules/engineInputGHCFile</module>
        <module>modules/engineOutputGHCFile</module>
    </modules>	
	

	<!-- Configuracion de Plugin de jsonschema2pojo para Generar clases Java en Subproyectos -->
    <build>
        <plugins>
			<plugin>
			    <groupId>org.jsonschema2pojo</groupId>
			    <artifactId>jsonschema2pojo-maven-plugin</artifactId>
			    <version>1.3.3</version>
			    <executions>
			     	<!-- Ejecución para engineInputGHCFile -->
			        <execution>
			          <id>generar-ghc-engine-input-file</id>
			          <phase>generate-sources</phase>
			          <goals>
			            <goal>generate</goal>
			          </goals>
			          <configuration>
			            <sourceDirectory>${basedir}/src/main/resources/schemas/common</sourceDirectory>
			            <includes>planningData.schema.json</includes>
			            <targetPackage>com.penalara.ghc.jsonghcfile</targetPackage>
			            <outputDirectory>${basedir}/modules/engineInputGHCFile/src/main/java</outputDirectory>
    				    <removeOldOutput>true</removeOldOutput>
					    <includeHashcodeAndEquals>false</includeHashcodeAndEquals>
					    <includeToString>false</includeToString>
					    <includeAdditionalProperties>true</includeAdditionalProperties>
					    <useTitleAsClassname>true</useTitleAsClassname>
					    <includeGeneratedAnnotation>false</includeGeneratedAnnotation>
			          </configuration>
	    			</execution>
			     	<!-- Ejecución para engineOutputGHCFile -->
			        <execution>
			          <id>generar-ghc-engine-output-file</id>
			          <phase>generate-sources</phase>
			          <goals>
			            <goal>generate</goal>
			          </goals>
			          <configuration>
			            <sourceDirectory>${basedir}/src/main/resources/schemas/common</sourceDirectory>
			            <includes>ghcEngineOutput.schema.json</includes>
			            <targetPackage>com.penalara.ghc.jsonghcfile</targetPackage>
			            <outputDirectory>${basedir}/modules/engineOutputGHCFile/src/main/java</outputDirectory>
    				    <removeOldOutput>true</removeOldOutput>
					    <includeHashcodeAndEquals>false</includeHashcodeAndEquals>
					    <includeToString>false</includeToString>
					    <includeAdditionalProperties>true</includeAdditionalProperties>
					    <useTitleAsClassname>true</useTitleAsClassname>
					    <includeGeneratedAnnotation>false</includeGeneratedAnnotation>
			          </configuration>
	    			</execution>
				     <!-- Ejecución para engineghcfile -->
			        <execution>
			          <id>generar-ghc-engine-file</id>
			          <phase>generate-sources</phase>
			          <goals>
			            <goal>generate</goal>
			          </goals>
			          <configuration>
			            <sourceDirectory>${basedir}/src/main/resources/schemas/engine</sourceDirectory>
			            <includes>ghcEngine.schema.json</includes>
			            <targetPackage>com.penalara.ghc.jsonghcfile</targetPackage>
			            <outputDirectory>${basedir}/modules/engineGHCFile/src/main/java</outputDirectory>
    				    <removeOldOutput>true</removeOldOutput>
					    <includeHashcodeAndEquals>false</includeHashcodeAndEquals>
					    <includeToString>false</includeToString>
					    <includeAdditionalProperties>true</includeAdditionalProperties>
					    <useTitleAsClassname>true</useTitleAsClassname>
					    <includeGeneratedAnnotation>false</includeGeneratedAnnotation>
			          </configuration>
	    			</execution>
			     	<!-- Ejecución para Planner -->
			        <execution>
			          <id>generar-ghc-planner-file</id>
			          <phase>generate-sources</phase>
			          <goals>
			            <goal>generate</goal>
			          </goals>
			          <configuration>
			            <sourceDirectory>${basedir}/src/main/resources/schemas/planner</sourceDirectory>
			            <includes>ghcMultiplatform.schema.json</includes>
			            <targetPackage>com.penalara.ghc.jsonghcfile</targetPackage>
			            <outputDirectory>${basedir}/modules/plannerGHCFile/src/main/java</outputDirectory>
    				    <removeOldOutput>true</removeOldOutput>
					    <includeHashcodeAndEquals>false</includeHashcodeAndEquals>
					    <includeToString>false</includeToString>
					    <includeAdditionalProperties>true</includeAdditionalProperties>
					    <useTitleAsClassname>true</useTitleAsClassname>
					    <includeGeneratedAnnotation>false</includeGeneratedAnnotation>
			          </configuration>
	    			</execution>
			    </executions>
			</plugin>
			<!-- Sonatype -->
	        <plugin>
	          <groupId>org.sonatype.central</groupId>
	          <artifactId>central-publishing-maven-plugin</artifactId>
	          <version>0.12.0</version>
	          <extensions>true</extensions>
	          <configuration>
	            <publishingServerId>central</publishingServerId>
				<skipPublishing>true</skipPublishing>
	          </configuration>
	        </plugin>
            <!-- Maven Release -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <arguments>-Pschema-docs -Djsonschema2pojo.skip=true</arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Generacion Markdown de la documentacion JSON Schema -->
        <profile>
            <id>schema-docs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>create-schema-documentation-directory</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>python</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>import pathlib, sys; pathlib.Path(sys.argv[1]).mkdir(parents=True, exist_ok=True)</argument>
                                        <argument>${maven.multiModuleProjectDirectory}/docs</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>generate-schema-documentation</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <executable>python</executable>
                                    <arguments>
                                        <argument>-m</argument>
                                        <argument>json_schema_for_humans.cli</argument>
                                        <argument>--config</argument>
                                        <argument>template_name=md</argument>
                                        <argument>--config</argument>
                                        <argument>link_to_reused_ref=true</argument>
                                        <argument>${maven.multiModuleProjectDirectory}/src/main/resources/schemas</argument>
                                        <argument>${maven.multiModuleProjectDirectory}/docs</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Generacion de interfaces TypeScript desde los JSON Schema comunes -->
        <profile>
            <id>typescript-interfaces</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>properties-maven-plugin</artifactId>
                        <version>1.3.1</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>load-typescript-interfaces-properties</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>read-project-properties</goal>
                                </goals>
                                <configuration>
                                    <files>
                                        <file>${typescript.propertiesFile}</file>
                                    </files>
                                    <quiet>true</quiet>
                                    <override>false</override>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>create-typescript-interfaces-directory</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>python</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>import pathlib, sys; destination = sys.argv[1]; destination and not destination.startswith('${') or sys.exit('Set directorioConfigurado with -DdirectorioConfigurado=... or in ' + sys.argv[2]); pathlib.Path(destination).mkdir(parents=True, exist_ok=True)</argument>
                                        <argument>${directorioConfigurado}</argument>
                                        <argument>${typescript.propertiesFile}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>generate-planning-ghc-data-interface</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <executable>npx</executable>
                                    <arguments>
                                        <argument>--yes</argument>
                                        <argument>quicktype@26.0.0</argument>
                                        <argument>--src-lang</argument>
                                        <argument>schema</argument>
                                        <argument>--lang</argument>
                                        <argument>typescript</argument>
                                        <argument>--just-types</argument>
                                        <argument>--no-prefer-unions</argument>
                                        <argument>--no-maps</argument>
                                        <argument>--prefer-unknown</argument>
                                        <argument>--top-level</argument>
                                        <argument>PlanningGhcData</argument>
                                        <argument>--out</argument>
                                        <argument>${directorioConfigurado}/planning-ghc-data.interface.ts</argument>
                                        <argument>--src</argument>
                                        <argument>src/main/resources/schemas/common/planningData.schema.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>generate-ghc-result-interface</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <executable>npx</executable>
                                    <arguments>
                                        <argument>--yes</argument>
                                        <argument>quicktype@26.0.0</argument>
                                        <argument>--src-lang</argument>
                                        <argument>schema</argument>
                                        <argument>--lang</argument>
                                        <argument>typescript</argument>
                                        <argument>--just-types</argument>
                                        <argument>--no-prefer-unions</argument>
                                        <argument>--no-maps</argument>
                                        <argument>--prefer-unknown</argument>
                                        <argument>--top-level</argument>
                                        <argument>GhcResult</argument>
                                        <argument>--out</argument>
                                        <argument>${directorioConfigurado}/ghc-result.interface.ts</argument>
                                        <argument>--src</argument>
                                        <argument>src/main/resources/schemas/common/ghcEngineOutput.schema.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    
    <!-- Configuracion de Control de versiones (Git)-->
	<scm>
	  <connection>scm:git:ssh://git@github.com/penalara/json-ghc-files.git</connection>
	  <developerConnection>scm:git:ssh://git@github.com/penalara/json-ghc-files.git</developerConnection>
	  <url>https://github.com/penalara/json-ghc-files/tree/main</url>
	  <tag>jsonGhcFiles-3.2.0</tag>
	</scm>

</project>
